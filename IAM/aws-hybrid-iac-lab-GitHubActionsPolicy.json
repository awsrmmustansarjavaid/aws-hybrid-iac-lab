{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "TerraformAndCloudFormationDeployment",
            "Effect": "Allow",
            "Action": [
                "cloudformation:*",
                "ec2:*",
                "s3:*",
                "iam:*",
                "ecr:*",
                "eks:*",
                "elasticloadbalancing:*",
                "autoscaling:*",
                "logs:*",
                "ssm:*",
                "secretsmanager:*",
                "kms:*",
                "lambda:*",
                "apigateway:*",
                "dynamodb:*",
                "rds:*",
                "ecs:*",
                "sts:GetCallerIdentity"
            ],
            "Resource": "*"
        }
    ]
}