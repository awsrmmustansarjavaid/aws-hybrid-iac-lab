# =======================================================

# PROJECT .gitignore

# AWS / TERRAFORM / DEVOPS PROJECT

# =======================================================

#

# Ignore generated files, temporary files, local settings,

# credentials, secrets, and environment-specific artifacts.

#

# IMPORTANT:

# Review sensitive files before committing them to GitHub.

# Never commit real passwords, tokens, private keys, or secrets.

# =======================================================

# =======================================================

# AWS / CLOUD CREDENTIALS

# =======================================================

# SSH and private key files

# Example: server.pem, aws-private.key

*.pem
*.key

# Local AWS credential/configuration directories and files

# Example: .aws/, credentials, aws-credentials

.aws/
aws-credentials*
credentials*
config*

# =======================================================

# TERRAFORM

# =======================================================

# -------------------------------------------------------

# Terraform working directories

# -------------------------------------------------------

#

# Ignore Terraform-generated working directories.

# Example: terraform/.terraform/

#

# This does NOT ignore your terraform source folder.

# Example: infrastructure/terraform/main.tf remains tracked.

# -------------------------------------------------------

**/.terraform/

# -------------------------------------------------------

# Terraform backup directories

# -------------------------------------------------------

#

# Ignore all local Terraform backup directories.

# Example: .terraform-backup-20260908/

#

# Backup folders may contain state files and provider binaries.

# -------------------------------------------------------

**/.terraform-backup-*/

# -------------------------------------------------------

# Terraform state files

# -------------------------------------------------------

#

# Ignore Terraform state files by default.

# State may contain resource details or sensitive values.

# -------------------------------------------------------

*.tfstate
*.tfstate.*

# -------------------------------------------------------

# Lab-specific Terraform state exception

# -------------------------------------------------------

#

# This educational lab intentionally tracks this state file.

# Example: infrastructure/terraform/terraform.tfstate

# -------------------------------------------------------

!infrastructure/terraform/terraform.tfstate

# -------------------------------------------------------

# Terraform variable files

# -------------------------------------------------------

#

# Terraform variable files are allowed in this repository.

# Example: terraform.tfvars

#

# IMPORTANT: Do not put passwords, tokens, or secrets here.

# -------------------------------------------------------

# Intentionally NOT ignoring *.tfvars

# Intentionally NOT ignoring *.tfvars.json

# -------------------------------------------------------

# Terraform example variable files

# -------------------------------------------------------

#

# Example files contain safe placeholder configuration.

# Example: terraform.tfvars.example

# -------------------------------------------------------

# No ignore rule required.

# Both .tfvars and .tfvars.example can be committed.

# -------------------------------------------------------

# Terraform plan files

# -------------------------------------------------------

#

# Terraform plans are generated locally or by CI/CD.

# Example: terraform-plan.txt, infrastructure.tfplan

# -------------------------------------------------------

*.tfplan
*.plan
terraform-plan.txt
**/terraform-plan.txt

# -------------------------------------------------------

# Terraform crash logs

# -------------------------------------------------------

#

# Ignore crash information generated after Terraform errors.

# Example: crash.log, crash.20260908.log

# -------------------------------------------------------

crash.log
crash.*.log

# -------------------------------------------------------

# Terraform override files

# -------------------------------------------------------

#

# Ignore local Terraform override configuration.

# Example: override.tf, development_override.tf

# -------------------------------------------------------

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# -------------------------------------------------------

# Terraform CLI configuration

# -------------------------------------------------------

#

# Ignore user-specific Terraform CLI configuration.

# Example: .terraformrc, terraform.rc

# -------------------------------------------------------

.terraformrc
terraform.rc

# =======================================================

# CLOUDFORMATION

# =======================================================

# Generated CloudFormation output and temporary artifacts

# Example: outputs/, generated deployment files

outputs/

# =======================================================

# ENVIRONMENT / SECRETS

# =======================================================

# Ignore environment files containing local configuration

# Example: .env, .env.local

.env
.env.*

# Allow safe example environment configuration

# Example: .env.example

!.env.example

# =======================================================

# OPERATING SYSTEM FILES

# =======================================================

# Ignore files automatically created by operating systems

# Example: .DS_Store, Thumbs.db, Desktop.ini

.DS_Store
Thumbs.db
Desktop.ini

# =======================================================

# IDE / CODE EDITOR FILES

# =======================================================

# Ignore local IDE and editor configuration

# Example: .vscode/, .idea/

.vscode/
.idea/

# =======================================================

# LOG FILES

# =======================================================

# Ignore application, deployment, and debugging logs

# Example: deployment.log, terraform.log

*.log

# =======================================================

# TEMPORARY FILES

# =======================================================

# Ignore temporary files created during development

# Example: test.tmp, temporary.temp

*.tmp
*.temp

# =======================================================

# DOCUMENTATION / GENERATED DOCUMENTS

# =======================================================

# Ignore generated/binary documentation files

# Example: report.pdf, document.docx

*.pdf
*.doc
*.docx

# Keep Markdown documentation in the doc directory

# Example: doc/setup.md, doc/deployment.md

!doc/*.md
!doc/**/*.md

# =======================================================

# GENERATED / BINARY MEDIA

# =======================================================

# Ignore common generated or large media files

# Example: screenshot.png, architecture.jpg

*.jpg
*.jpeg
*.png
*.gif
*.webp

# =======================================================

# LOCAL BACKUP FILES

# =======================================================

# Ignore editor, application, and local backup files

# Example: backup.bak, file.swp, temporary~

*.bak
*.swp
*.swo
*~

# ============================================================
# GENERATED REPORTS AND AUDIT LOGS
# ============================================================
#
# Ignore the complete report-log directory.
# These files are generated locally by audit/preflight scripts
# and should NOT be committed or pushed to GitHub.
#
# This rule ignores all files and subdirectories inside:
#   report-log/
# ============================================================

report-log/

# ============================================================
# GENERATED ROOT-LEVEL AUDIT REPORT
# ============================================================
#
# Ignore the generated audit report created in the project root.
# ============================================================

cloudformation-audit-report.txt

# =======================================================

# END OF .gitignore

# =======================================================
