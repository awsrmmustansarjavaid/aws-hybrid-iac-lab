# ============================================================
# HYBRID TERRAFORM + CLOUDFORMATION AWS DEVOPS LAB
# ============================================================
#
# File:
#
#     infrastructure/terraform/terraform.tfvars
#
# Purpose:
#
#     Provides environment-specific input values to Terraform.
#
#
# ============================================================
# HYBRID IaC ARCHITECTURE
# ============================================================
#
# Terraform
#     |
#     +--> CloudFormation Template S3 Bucket
#     |
#     +--> CloudFormation Root Stack
#              |
#              +--> VPC Nested Stack
#              +--> S3 Nested Stack
#              +--> DynamoDB Nested Stack
#              +--> ECR Nested Stack
#              +--> Lambda Nested Stack
#              +--> API Gateway Nested Stack
#              +--> CloudFront Nested Stack
#              +--> EC2 Nested Stack
#              +--> ECS Nested Stack
#              +--> EKS Nested Stack
#              +--> RDS Nested Stack
#
#
# ============================================================
# SECURITY
# ============================================================
#
# IMPORTANT:
#
# This file can contain environment-specific and sensitive
# values.
#
# Do NOT commit real secrets or passwords to GitHub.
#
#
# Recommended .gitignore entries:
#
#     terraform.tfvars
#     *.tfvars
#     *.tfvars.json
#
#
# For GitHub Actions / CI/CD use:
#
#     GitHub Secrets
#     GitHub Variables
#     AWS Secrets Manager
#     OIDC
#     or another secure secret-management solution.
#
# ============================================================


# ============================================================
# 1. AWS REGION
# ============================================================
#
# AWS region where this Terraform + CloudFormation lab will
# operate.
#
# Current lab region:
#
#     us-east-1
#
# ============================================================

aws_region = "us-east-1"


# ============================================================
# 2. PROJECT NAME
# ============================================================
#
# Common project name used by Terraform and CloudFormation.
#
# ============================================================

project_name = "HybridIaCLab"


# ============================================================
# 3. ENVIRONMENT
# ============================================================
#
# Deployment environment.
#
# Current environment:
#
#     dev
#
# Possible environments:
#
#     dev
#     test
#     staging
#     prod
#
# ============================================================

environment = "dev"


# ============================================================
# 4. VPC ID
# ============================================================
#
# Existing VPC that will be supplied to the CloudFormation
# root stack.
#
# IMPORTANT:
#
# Replace the value below with the REAL VPC ID from AWS.
#
# Expected format:
#
#     vpc-0123456789abcdef0
#
# Example only:
#
#     vpc-0123456789abcdef0
#
# Do NOT use the example value.
#
# ============================================================

vpc_id = "REPLACE_WITH_REAL_VPC_ID"


# ============================================================
# 5. PRIMARY PUBLIC SUBNET ID
# ============================================================
#
# Primary public subnet supplied to CloudFormation.
#
# Expected format:
#
#     subnet-0123456789abcdef0
#
# Replace with the REAL subnet ID.
#
# ============================================================

public_subnet_id = "REPLACE_WITH_REAL_PUBLIC_SUBNET_ID"


# ============================================================
# 6. PUBLIC SUBNET 1 ID
# ============================================================
#
# First public subnet used by the Multi-AZ architecture.
#
# Expected format:
#
#     subnet-0123456789abcdef0
#
# This should normally be in one Availability Zone.
#
# ============================================================

public_subnet_1_id = "REPLACE_WITH_REAL_PUBLIC_SUBNET_1_ID"


# ============================================================
# 7. PUBLIC SUBNET 2 ID
# ============================================================
#
# Second public subnet used by the Multi-AZ architecture.
#
# Expected format:
#
#     subnet-0123456789abcdef0
#
# Ideally this subnet should be in a different Availability
# Zone from public_subnet_1_id.
#
# ============================================================

public_subnet_2_id = "REPLACE_WITH_REAL_PUBLIC_SUBNET_2_ID"


# ============================================================
# 8. PRIVATE SUBNET 1 ID
# ============================================================
#
# First private subnet supplied to CloudFormation.
#
# Expected format:
#
#     subnet-0123456789abcdef0
#
# ============================================================

private_subnet_1_id = "REPLACE_WITH_REAL_PRIVATE_SUBNET_1_ID"


# ============================================================
# 9. PRIVATE SUBNET 2 ID
# ============================================================
#
# Second private subnet supplied to CloudFormation.
#
# Expected format:
#
#     subnet-0123456789abcdef0
#
# Ideally this subnet should be in a different Availability
# Zone from private_subnet_1_id.
#
# ============================================================

private_subnet_2_id = "REPLACE_WITH_REAL_PRIVATE_SUBNET_2_ID"


# ============================================================
# 10. AMAZON LINUX 2023 AMI ID
# ============================================================
#
# AMI used by the EC2 CloudFormation nested stack.
#
# The AMI must exist in:
#
#     us-east-1
#
#
# Recommended PowerShell command:
#
#     aws ssm get-parameter `
#       --name "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64" `
#       --query "Parameter.Value" `
#       --output text `
#       --region us-east-1
#
#
# AWS should return something similar to:
#
#     ami-0123456789abcdef0
#
#
# Copy the REAL returned AMI ID into the variable below.
#
# ============================================================

ami_id = "REPLACE_WITH_REAL_AMAZON_LINUX_2023_AMI_ID"


# ============================================================
# 11. APPLICATION S3 BUCKET NAME
# ============================================================
#
# Application S3 bucket used by the CloudFormation application
# infrastructure.
#
# IMPORTANT:
#
# This is NOT necessarily the same bucket as the Terraform
# CloudFormation template bucket.
#
#
# Terraform CloudFormation template bucket currently used by
# the project:
#
#     hybridiaclab-dev-cfn-templates-a635abe09098d12756b031e2bb
#
#
# The value below must be the actual application bucket
# expected by your CloudFormation main.yaml / nested stack
# architecture.
#
#
# S3 bucket names must be globally unique.
#
# ============================================================

application_bucket_name = "REPLACE_WITH_REAL_APPLICATION_BUCKET_NAME"


# ============================================================
# 12. LAMBDA FUNCTION ARN
# ============================================================
#
# ARN of the Lambda function expected by the CloudFormation
# infrastructure.
#
# Expected format:
#
#     arn:aws:lambda:us-east-1:537236558357:function:FunctionName
#
#
# Replace with the REAL Lambda function ARN.
#
# ============================================================

lambda_function_arn = "REPLACE_WITH_REAL_LAMBDA_FUNCTION_ARN"


# ============================================================
# 13. ECR IMAGE URI
# ============================================================
#
# URI of the container image used by CloudFormation/ECS.
#
# Expected format:
#
#     537236558357.dkr.ecr.us-east-1.amazonaws.com/my-app:latest
#
#
# IMPORTANT:
#
# The ECR repository and image tag must exist before the
# dependent ECS deployment attempts to use the image.
#
# Replace with the REAL image URI.
#
# ============================================================

ecr_image_uri = "REPLACE_WITH_REAL_ECR_IMAGE_URI"


# ============================================================
# 14. DATABASE PASSWORD
# ============================================================
#
# Password supplied to the CloudFormation RDS nested stack.
#
# ============================================================
# SECURITY WARNING
# ============================================================
#
# This value is sensitive.
#
# Even when a CloudFormation parameter is configured with
# NoEcho=true, the value may still exist in Terraform state
# because Terraform passes the value to CloudFormation.
#
#
# Therefore:
#
#     1. NEVER commit the real password to GitHub.
#
#     2. Keep terraform.tfvars in .gitignore.
#
#     3. Protect the Terraform state backend.
#
#     4. Do not put passwords directly inside .tf files.
#
#     5. Prefer AWS Secrets Manager for production systems.
#
#
# The password must satisfy the password requirements defined
# by your RDS CloudFormation template.
#
# ============================================================

database_password = "REPLACE_WITH_STRONG_DATABASE_PASSWORD"


# ============================================================
# VALIDATION CHECKLIST
# ============================================================
#
# Before running:
#
#     terraform plan
#
# make sure these placeholders have been replaced:
#
#     REPLACE_WITH_REAL_VPC_ID
#
#     REPLACE_WITH_REAL_PUBLIC_SUBNET_ID
#
#     REPLACE_WITH_REAL_PUBLIC_SUBNET_1_ID
#
#     REPLACE_WITH_REAL_PUBLIC_SUBNET_2_ID
#
#     REPLACE_WITH_REAL_PRIVATE_SUBNET_1_ID
#
#     REPLACE_WITH_REAL_PRIVATE_SUBNET_2_ID
#
#     REPLACE_WITH_REAL_AMAZON_LINUX_2023_AMI_ID
#
#     REPLACE_WITH_REAL_APPLICATION_BUCKET_NAME
#
#     REPLACE_WITH_REAL_LAMBDA_FUNCTION_ARN
#
#     REPLACE_WITH_REAL_ECR_IMAGE_URI
#
#     REPLACE_WITH_STRONG_DATABASE_PASSWORD
#
#
# ============================================================
# IMPORTANT
# ============================================================
#
# Do NOT weaken the validation rules in variables.tf just to
# make these placeholder values pass validation.
#
# The validation is intentionally protecting the deployment
# from invalid AWS identifiers.
#
#
# ============================================================
# TERRAFORM COMMANDS
# ============================================================
#
# Format Terraform configuration:
#
#     terraform fmt
#
#
# Validate configuration:
#
#     terraform validate
#
#
# Review deployment plan:
#
#     terraform plan
#
#
# Do NOT run terraform apply until the complete plan has been
# reviewed.
#
# ============================================================
# END OF terraform.tfvars
# ============================================================