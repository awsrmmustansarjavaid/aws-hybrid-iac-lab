# ============================================================
# HYBRID TERRAFORM + CLOUDFORMATION AWS DEVOPS LAB
# ============================================================
#
# File:
#
#   infrastructure/terraform/terraform.tfvars.example
#
# Purpose:
#
#   Example/template Terraform configuration showing the
#   variables required by the Hybrid Terraform +
#   CloudFormation architecture.
#
#
# ============================================================
# IMPORTANT
# ============================================================
#
# This is an EXAMPLE file.
#
# It must NOT contain:
#
#   - Real database passwords
#   - Real secrets
#   - Private credentials
#   - Unnecessary production values
#
#
# Recommended workflow:
# 
#    1. Copy or use this file as the template for:
#    
#         terraform.tfvars
# 
#    2. Review the environment-specific values.
# 
#   3. Do NOT add passwords, access keys, tokens, private keys,
#       or other secrets.
#
#   4. Because this project uses non-secret configuration in
#      terraform.tfvars, the resulting file may be committed
#      to GitHub as long as it contains no sensitive values.
#
#
# ============================================================
# ARCHITECTURE
# ============================================================
#
# Terraform manages:
#
#   - IAM
#   - CloudFormation root stack
#   - CloudFormation template bucket
#   - Other Terraform-specific infrastructure
#
#
# CloudFormation creates:
#
#   - VPC
#   - Subnets
#   - Application S3 bucket
#   - Lambda
#   - ECR repository
#   - DynamoDB
#   - API Gateway
#   - CloudFront
#   - EC2
#   - ECS
#   - EKS
#   - RDS
#
#
# Therefore this example intentionally DOES NOT contain
# variables for CloudFormation-created resource IDs or ARNs.
#
#
# ============================================================
# IAM ARCHITECTURE
# ============================================================
#
# Terraform creates/manages the IAM resources.
#
# Therefore IAM resource NAME variables are included:
#
#   github_actions_role_name
#   github_actions_policy_name
#   terraform_backend_policy_name
#   github_ci_cd_combined_policy_name
#
#
# The IAM policy JSON documents themselves remain in:
#
#   repository-root/IAM/
#
#
# Do NOT add:
#
#   iam_policy_directory
#
#
# Do NOT add IAM ARN variables such as:
#
#   github_actions_role_arn
#   github_actions_policy_arn
#
#
# Terraform obtains those values directly from the resources
# it creates.
#
#
# ============================================================


# ============================================================
# 1. AWS REGION
# ============================================================
#
# Example:
#
#   us-east-1
#
# ============================================================

aws_region = "us-east-1"



# ============================================================
# 2. PROJECT NAME
# ============================================================
#
# Main project/lab name.
#
# ============================================================

project_name = "hybridiaclab"



# ============================================================
# 3. ENVIRONMENT
# ============================================================
#
# Supported:
#
#   dev
#   test
#   staging
#   prod
#
# ============================================================

environment = "dev"



# ============================================================
# 4. DATABASE USERNAME
# ============================================================
#
# RDS administrator username.
#
# ============================================================

database_username = "admin"



# ============================================================
# 5. GITHUB ACTIONS IAM ROLE NAME
# ============================================================
#
# Name of the IAM role assumed by GitHub Actions through
# GitHub OIDC.
#
# Terraform creates/manages this role.
#
# ============================================================

github_actions_role_name = "aws-hybrid-iac-lab-GitHubActions"



# ============================================================
# 6. GITHUB ACTIONS IAM POLICY NAME
# ============================================================
#
# Name of the customer-managed IAM policy attached to the
# GitHub Actions OIDC role.
#
# The policy JSON document itself is stored under:
#
#   IAM/aws-hybrid-iac-lab-GitHubActionsPolicy.json
#
# ============================================================

github_actions_policy_name = "aws-hybrid-iac-lab-GitHubActionsPolicy"



# ============================================================
# 7. TERRAFORM BACKEND IAM POLICY NAME
# ============================================================
#
# Name of the customer-managed IAM policy used by the
# Terraform backend.
#
# ============================================================

terraform_backend_policy_name = "github-actions-terraform-backend-policy"



# ============================================================
# 8. GITHUB CI/CD COMBINED IAM POLICY NAME
# ============================================================
#
# Name of the customer-managed IAM policy containing the
# combined AWS permissions required by the GitHub CI/CD
# identity.
#
# The policy document itself is stored under:
#
#   IAM/github-ci-cd-user-combined-access.json
#
# ============================================================

github_ci_cd_combined_policy_name = "github-ci-cd-user-combined-access"


# ============================================================
# ARCHITECTURE NOTE
# ============================================================
#
# The following values are intentionally NOT configured as
# Terraform input variables:
#
#   vpc_id
#   public_subnet_id
#   public_subnet_1_id
#   public_subnet_2_id
#   private_subnet_1_id
#   private_subnet_2_id
#   application_bucket_name
#   lambda_function_arn
#   ecr_image_uri
#
# These values are created by CloudFormation.
#
#
# Example:
#
#   Terraform
#       |
#       v
#   CloudFormation Root Stack
#       |
#       +--> VPC Stack
#       |      |
#       |      +--> VpcId
#       |      +--> PublicSubnet1Id
#       |      +--> PublicSubnet2Id
#       |      +--> PrivateSubnet1Id
#       |      +--> PrivateSubnet2Id
#       |
#       +--> S3 Stack
#       |      |
#       |      +--> Application Bucket
#       |
#       +--> Lambda Stack
#       |      |
#       |      +--> Lambda Function
#       |
#       +--> ECR Stack
#       |
#       +--> Database Stack
#       |
#       +--> Application Stacks
#
#
# CloudFormation outputs should be used when another
# CloudFormation stack or Terraform resource needs values
# created inside the hierarchy.
#
#
# ============================================================
# IAM NOTE
# ============================================================
#
# IAM is managed separately by Terraform.
#
#
# Example:
#
#   Terraform
#       |
#       +--> IAM Role
#       |
#       +--> IAM Policy
#       |
#       +--> Policy Attachment
#       |
#       v
#      AWS IAM
#
#
# IAM JSON policy files remain repository files:
#
#   repository-root/
#   |
#   +-- IAM/
#       |
#       +-- aws-hybrid-iac-lab-GitHubActionsPolicy.json
#       +-- github-actions-terraform-backend-policy.json
#       +-- github-ci-cd-user-combined-access.json
#
#
# iam.tf references these using the fixed repository path.
#
#
# ============================================================
# EXAMPLE FILE CHECKLIST
# ============================================================
#
# The following values are configured in this example:
#
#   [x] aws_region
#   [x] project_name
#   [x] environment
#   [x] database_username
#
# Terraform-managed IAM names:
#
#   [x] github_actions_role_name
#   [x] github_actions_policy_name
#   [x] terraform_backend_policy_name
#   [x] github_ci_cd_combined_policy_name
#
#
# The following values are intentionally NOT configured here:
#
#   ami_id
#
#       Dynamically discovered by data.tf.
#
#
#   database_password
#
#       Managed through AWS Secrets Manager.
#
#
# No passwords, access keys, tokens, private keys, or other
# secrets should be added when creating terraform.tfvars.
#
# ============================================================
#
#
# ============================================================
# EC2 AMI CONFIGURATION
# ============================================================
#
# The EC2 AMI ID is intentionally NOT included in this file.
#
# Terraform dynamically discovers the latest matching
# Amazon Linux 2023 x86_64 AMI using the data source defined in:
#
#   infrastructure/terraform/data.tf
#
# Terraform obtains the AMI ID from:
#
#   data.aws_ami.amazon_linux_2023.id
#
# Therefore no manual ami_id value is required here.
#
# ============================================================
#
# ============================================================
# RDS PASSWORD MANAGEMENT
# ============================================================
#
# The RDS database password is intentionally NOT included
# in this example file.
#
# The RDS password is managed through AWS Secrets Manager
# by the CloudFormation RDS configuration.
#
# Therefore:
#
#   database_password
#
# is NOT a Terraform input variable for this configuration.
#
# NEVER add the real RDS password to:
#
#   terraform.tfvars
#   terraform.tfvars.example
#
# ============================================================
#
# ============================================================
# VARIABLES INTENTIONALLY REMOVED
# ============================================================
#
# These are no longer Terraform input variables because
# CloudFormation creates the corresponding resources:
#
#   [x] vpc_id
#   [x] public_subnet_id
#   [x] public_subnet_1_id
#   [x] public_subnet_2_id
#   [x] private_subnet_1_id
#   [x] private_subnet_2_id
#   [x] application_bucket_name
#   [x] lambda_function_arn
#
#
# ============================================================
# IAM VALUES INTENTIONALLY NOT INCLUDED
# ============================================================
#
# These are intentionally NOT configured as Terraform input
# variables:
#
#   [x] github_actions_role_arn
#   [x] github_actions_policy_arn
#   [x] terraform_backend_policy_arn
#   [x] iam_policy_directory
#
#
# IAM ARNs are obtained from Terraform-managed IAM resources.
#
# The IAM directory is a fixed repository path.
# ============================================================
#
# ============================================================
# DYNAMIC AWS INFORMATION
# ============================================================
#
# Terraform also dynamically retrieves AWS information
# using Terraform data sources.
#
# Currently:
#
#   - Amazon Linux 2023 AMI is discovered dynamically
#     through infrastructure/terraform/data.tf
#
# Therefore the AMI ID does not need to be manually
# configured in this file.
#
# ============================================================
# END OF terraform.tfvars.example
# ============================================================